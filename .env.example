# Copy file ini jadi .env lalu isi nilainya. JANGAN commit file .env!
# (.env sudah masuk .gitignore)

# === PILIH AI (bebas!) ===
# groq | gemini | openrouter  (default: groq)
LLM_PROVIDER=groq
# Opsional: timpa model default. Kosongkan untuk pakai default.
#   groq default: gpt-oss-120b
#   gemini default: gemini-2.0-flash
#   openrouter default: deepseek/deepseek-chat:free
LLM_MODEL=

# Groq API key (gratis): https://console.groq.com
GROQ_API_KEY=

# Google Gemini API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter API key (banyak model gratis): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Instagram Graph API (dari Meta Developer Dashboard)
IG_USER_ID=
IG_ACCESS_TOKEN=

# ImgBB API key (gratis, untuk upload gambar sebelum posting): https://api.imgbb.com
IMGBB_API_KEY=