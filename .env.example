# Copy file ini jadi .env lalu isi nilainya. JANGAN commit file .env!
# (.env sudah masuk .gitignore)

# Groq API key (gratis): https://console.groq.com
GROQ_API_KEY=

# Instagram Graph API (dari Meta Developer Dashboard)
IG_USER_ID=
IG_ACCESS_TOKEN=

# ImgBB API key (gratis, untuk upload gambar sebelum posting): https://api.imgbb.com
IMGBB_API_KEY=
